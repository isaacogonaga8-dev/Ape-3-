import java.util.Scanner;

public class Ejercicio02_ControlEdades {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        int edad;
        int suma = 0;
        int cantidad = 0;
        int menores = 0;
        int adultos = 0;
        int mayores65 = 0;
        double promedio;

        System.out.print("Ingrese una edad (-1 para terminar): ");
        edad = entrada.nextInt();

        while (edad != -1) {

            while (edad < 0) {
                System.out.print("Edad no valida. Ingrese nuevamente: ");
                edad = entrada.nextInt();
            }

            if (edad != -1) {

                suma = suma + edad;
                cantidad = cantidad + 1;

                if (edad < 18) {
                    menores = menores + 1;
                } else if (edad <= 65) {
                    adultos = adultos + 1;
                } else {
                    mayores65 = mayores65 + 1;
                }

                System.out.print("Ingrese otra edad (-1 para terminar): ");
                edad = entrada.nextInt();
            }
        }

        if (cantidad > 0) {
            promedio = (double) suma / cantidad;
        } else {
            promedio = 0;
        }

        System.out.println("\n--- RESULTADOS ---");
        System.out.println("Menores de edad: " + menores);
        System.out.println("Adultos: " + adultos);
        System.out.println("Mayores de 65 años: " + mayores65);
        System.out.println("Promedio de edades: " + promedio);

        entrada.close();
    }
}
