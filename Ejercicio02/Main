import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        int edad;
        int suma = 0;
        int contador = 0;
        int menores = 0;
        int adultos = 0;
        int mayores65 = 0;
        double promedio;

        // Ingresar edades hasta utilizar el valor centinela
        System.out.print("Ingrese una edad (-1 para terminar): ");
        edad = entrada.nextInt();

        while (edad != -1) {

            // Validar que la edad sea positiva
            while (edad < 0) {
                System.out.println("Edad no valida.");
                System.out.print("Ingrese nuevamente: ");
                edad = entrada.nextInt();
            }

            if (edad != -1) {
                suma = suma + edad;
                contador++;

                // Contar menores de edad
                if (edad < 18) {
                    menores++;
                }

                // Contar adultos
                if (edad >= 18 && edad <= 65) {
                    adultos++;
                }

                // Contar mayores de 65 años
                if (edad > 65) {
                    mayores65++;
                }
            }

            if (edad != -1) {
                System.out.print(
                        "Ingrese otra edad (-1 para terminar): "
                );
                edad = entrada.nextInt();
            }
        }

        // Calcular el promedio si se ingresaron edades
        if (contador > 0) {
            promedio = (double) suma / contador;

            System.out.println();
            System.out.println("===== RESULTADOS =====");
            System.out.println("Cantidad de edades: " + contador);
            System.out.println("Suma de edades: " + suma);
            System.out.println("Promedio de edades: " + promedio);
        } else {
            System.out.println();
            System.out.println("No se ingresaron edades.");
        }

        entrada.close();
    }
}
