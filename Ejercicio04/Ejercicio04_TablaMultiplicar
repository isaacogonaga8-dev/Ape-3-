package ejercicio04;

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        // Variables de la tabla de multiplicar
        int numero;
        int resultado;

        // Solicitar el numero al usuario
        System.out.print("Ingrese un numero entre 1 y 12: ");
        numero = entrada.nextInt();

        // Validar que el numero este entre 1 y 12
        while (numero < 1 || numero > 12) {

            System.out.print(
                    "Numero no valido. Ingrese un numero entre 1 y 12: "
            );

            numero = entrada.nextInt();
        }

        // Mostrar el titulo de la tabla
        System.out.println("\nTabla de multiplicar del " + numero);

    }
}
