package ejercicio03;

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        // Variables de la calculadora
        int opcion;
        double num1;
        double num2;
        double resultado;

        // Repetir el menu hasta seleccionar la opcion 5
        do {

            // Mostrar las opciones de la calculadora
            System.out.println("\n==========================");
            System.out.println("       CALCULADORA");
            System.out.println("==========================");
            System.out.println("1. Sumar");
            System.out.println("2. Restar");
            System.out.println("3. Multiplicar");
            System.out.println("4. Dividir");
            System.out.println("5. Salir");
            System.out.print("Seleccione una opcion: ");

            opcion = entrada.nextInt();

            // Evaluar la opcion seleccionada
            switch (opcion) {

                case 1:
                    // Solicitar los dos numeros
                    System.out.print("Ingrese el primer numero: ");
                    num1 = entrada.nextDouble();

                    System.out.print("Ingrese el segundo numero: ");
                    num2 = entrada.nextDouble();

                    // Realizar la suma
                    resultado = num1 + num2;

                    System.out.println("Resultado: " + resultado);
                    break;

                case 2:
                    // Solicitar los dos numeros
                    System.out.print("Ingrese el primer numero: ");
                    num1 = entrada.nextDouble();

                    System.out.print("Ingrese el segundo numero: ");
                    num2 = entrada.nextDouble();

                    // Realizar la resta
                    resultado = num1 - num2;

                    System.out.println("Resultado: " + resultado);
                    break;

                case 3:
                    // Solicitar los dos numeros
                    System.out.print("Ingrese el primer numero: ");
                    num1 = entrada.nextDouble();

                    System.out.print("Ingrese el segundo numero: ");
                    num2 = entrada.nextDouble();

                    // Realizar la multiplicacion
                    resultado = num1 * num2;

                    System.out.println("Resultado: " + resultado);
                    break;

                case 4:
                    // Solicitar los dos numeros
                    System.out.print("Ingrese el primer numero: ");
                    num1 = entrada.nextDouble();

                    System.out.print("Ingrese el segundo numero: ");
                    num2 = entrada.nextDouble();

                    // Verificar que el divisor no sea cero
                    if (num2 == 0) {
                        System.out.println(
                                "Error: no se puede dividir entre cero."
                        );
                    } else {
                        // Realizar la division
                        resultado = num1 / num2;

                        System.out.println(
                                "Resultado: " + resultado
                        );
                    }
                    break;

                case 5:
                    // Finalizar el programa
                    System.out.println("Programa finalizado.");
                    break;

                default:
                    // Mostrar mensaje para una opcion incorrecta
                    System.out.println("Opcion no valida.");
                    break;
            }

        } while (opcion != 5);

        // Cerrar el Scanner
        entrada.close();

    }
}
